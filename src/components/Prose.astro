---
// 文章排版容器 - 为 MDX 内容提供一致的 typography 样式
---

<div class="prose-notes">
  <slot />
</div>

<style>
  .prose-notes {
    color: var(--color-text);
    line-height: 1.8;
  }

  .prose-notes :global(h2) {
    color: var(--color-primary);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose-notes :global(h3) {
    color: var(--color-primary);
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-notes :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose-notes :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose-notes :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-notes :global(strong) {
    color: var(--color-primary);
    font-weight: 600;
  }

  .prose-notes :global(code) {
    background: var(--color-border);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
</style>
