---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../config/categories';
import { url } from '../config/site';
interface Props { project: CollectionEntry<'projects'>; headingLevel?: 'h2' | 'h3'; wide?: boolean; }
const { project, headingLevel: Heading = 'h2', wide = false } = Astro.props;
const { title, tagline, category, stage, role, highlight, tags } = project.data;
---
<a href={url(`/projects/${project.id}`)} data-project-link class:list={['project-card group', { 'project-card-wide': wide }]}>
  <div class="project-card-meta"><span class="category-label">{categoryLabels[category]}</span><span class="project-stage">{stage}</span></div>
  <Heading class="project-card-title">{title}</Heading>
  <p class="project-card-tagline">{tagline}</p>
  <div class="project-card-details"><p><span>我的职责</span>{role}</p><p><span>{stage === '阶段未披露' ? '设计目标' : '已记录结果'}</span>{highlight}</p></div>
  <div class="project-card-tags">{tags.map(tag => <span>{tag}</span>)}</div>
  <span class="project-card-link">查看案例 <span aria-hidden="true">↗</span></span>
</a>
