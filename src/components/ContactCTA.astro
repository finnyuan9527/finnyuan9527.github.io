---
import { url } from '../config/site';
interface Props { title?: string; description?: string; }
const { title = '在这里，保持相遇', description = '如果某段经历、某个问题或一篇文字让你有话想说，欢迎写信。' } = Astro.props;
---
<aside class="contact-panel" aria-label="交流与联系"><div><h2>{title}</h2><p>{description}</p></div><a href={url('/contact')} class="button-primary">联系我 <span aria-hidden="true">↗</span></a></aside>
