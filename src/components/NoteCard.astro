---
import type { CollectionEntry } from 'astro:content';
import { url } from '../config/site';

interface Props {
  note: CollectionEntry<'notes'>;
  headingLevel?: 'h2' | 'h3';
}

const { note, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, date, tags } = note.data;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={url(`/notes/${note.id}`)} class="note-card group">
  <time class="note-date" datetime={date.toISOString()}>{dateStr}</time>
  <div class="note-copy"><Heading class="note-title">{title}</Heading><p>{description}</p>{tags.length > 0 && <div class="note-tags">{tags.map(tag => <span>{tag}</span>)}</div>}</div>
  <span class="note-arrow" aria-hidden="true">↗</span>
</a>
