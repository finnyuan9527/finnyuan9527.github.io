---
import type { CollectionEntry } from 'astro:content';
import { url } from '../config/site';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, description, date, tags } = note.data;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={url(`/notes/${note.id}`)}
  class="group relative block overflow-hidden rounded-xl border border-[var(--color-border)] bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[rgb(11_42_74/0.08)]"
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] transition-transform duration-300 group-hover:scale-x-100"
  ></span>
  <div class="flex items-center gap-2 text-sm text-[var(--color-muted)]">
    <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
    <time class="tabular-nums" datetime={date.toISOString()}>{dateStr}</time>
  </div>
  <h3 class="mt-2 text-lg text-[var(--color-primary)] group-hover:text-[var(--color-accent)]">
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{description}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs text-[var(--color-accent)]">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
