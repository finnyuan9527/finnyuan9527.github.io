---
import { site, url, stripBase } from '../config/site';

const currentPath = stripBase(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={url('/')} class="flex items-center gap-2 text-[var(--color-primary)] font-semibold">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-[var(--color-primary)] text-sm font-bold text-[var(--color-accent)]">
        F
      </span>
      <span class="text-sm">{site.name}</span>
    </a>
    <ul class="flex items-center gap-6 text-sm">
      {site.nav.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'transition-colors',
              isActive(item.href)
                ? 'text-[var(--color-primary)] font-medium'
                : 'text-[var(--color-muted)] hover:text-[var(--color-primary)]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
