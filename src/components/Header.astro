---
import { site, url, stripBase } from '../config/site';

const currentPath = stripBase(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header id="top" class="sticky top-0 z-50 border-b border-[var(--color-accent)]/10 bg-[var(--color-bg)]/60 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href={url('/')} class="font-display text-lg font-bold tracking-tight text-[var(--color-primary)]">
      {site.name}
    </a>
    <ul class="flex items-center gap-7 text-sm">
      {site.nav.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'relative transition-colors after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:origin-left after:rounded-full after:bg-[var(--color-accent)] after:transition-transform after:duration-300',
              isActive(item.href)
                ? 'font-medium text-[var(--color-accent)] after:scale-x-100'
                : 'text-[var(--color-muted)] after:scale-x-0 hover:text-[var(--color-accent)] hover:after:scale-x-100',
            ]}
            style="letter-spacing: 0.0875em"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
