---
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 文章类页面传入,用于生成 Article 结构化数据与 article meta */
  article?: {
    publishedTime: Date;
    tags?: string[];
  };
}

const { title, description = site.description, image, article } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image || '/og-image.png', Astro.site).toString();

// JSON-LD: Person(全站) + Article(文章页)
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameEn,
  jobTitle: site.role,
  description: site.description,
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  sameAs: [site.github],
};

const articleJsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.publishedTime.toISOString(),
      author: { '@type': 'Person', name: site.name, url: Astro.site?.toString() },
      keywords: article.tags?.join(', '),
      mainEntityOfPage: canonical,
    }
  : null;
---

<!-- Primary Meta -->
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} · 思考`} href={new URL('/rss.xml', Astro.site).toString()} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImage} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article && <meta property="article:author" content={site.name} />}
{article && article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD 结构化数据 -->
<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
