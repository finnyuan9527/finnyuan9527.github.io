---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { url } from '../config/site';



// 职业阶段 - 基于真实经历,电影时间线
const journey = [
  {
    phase: '2012 · 北京',
    title: '互联网核心系统',
    body: '先后任职于多家在线旅游与文娱类互联网企业,参与订单、支付清结算、供应链等核心系统建设,建立工程化基础。',
  },
  {
    phase: '2018 · 加入集团',
    title: '企业平台与系统集成',
    body: '进入超大型多元化集团 IT 共享中心,负责低代码平台、主数据、数据链路与跨系统集成。',
  },
  {
    phase: '2024 · 转向 AI',
    title: '企业级 AI 从 0 到 1',
    body: '部署开源推理引擎,落地面向专业研发场景的知识平台、企业知识库 RAG 与外部客户 RAG 交付。',
  },
  {
    phase: '2026 · 现在',
    title: '集团 AI 产品与技术负责人',
    body: '主导 AI 能力中枢、智能体平台、统一 AI 入口建设,牵头集团统一 AI 技术架构治理。',
  },
];

// 能力地图
const abilityMap = [
  {
    direction: 'AI 架构与平台',
    detail: '企业级 AI 平台、模型网关、模型接入、路由、权限、成本与稳定性治理',
    expression: '让 AI 能力从单点试验走向统一平台和规模化使用',
  },
  {
    direction: 'Agent 与 RAG',
    detail: '智能体、知识库、检索增强、深度研究、文档解析、工作流编排',
    expression: '把模型能力嵌入真实业务任务和知识流程',
  },
  {
    direction: '企业数字化',
    detail: '低代码、主数据、OA、协同办公平台、数据链路、系统集成与迁移',
    expression: '理解企业复杂系统,并处理跨系统协同问题',
  },
  {
    direction: '工程交付',
    detail: '方案评审、架构设计、代码开发、测试、上线、监控、运维和故障处理',
    expression: '拥有从概念到生产环境的完整交付能力',
  },
  {
    direction: '业务协作',
    detail: '与 HR、财务、业务条线、供应商和技术团队共同推进项目',
    expression: '把技术语言转译为业务目标、验收标准和可执行计划',
  },
  {
    direction: '技术赋能',
    detail: '内部培训、技术分享、工具推广和 AI 使用方法总结',
    expression: '帮助团队从工具使用走向能力建设',
  },
];

// 工作方法与价值观
const values = [
  {
    title: '从验证开始,而不是从想象开始',
    body: '在 AI 项目中倾向于先做小规模 POC,再通过 MVP、增量迭代和规模化逐步推进,并为每个阶段设置可量化的验收标准。',
  },
  {
    title: '从技术走到业务现场',
    body: '不把 AI 描述成孤立的模型能力,而是把它放进数据、系统、流程、权限、成本和组织协作中考察。',
  },
  {
    title: '既追求前沿,也重视边界',
    body: '认可 AI 在方案文档、会议纪要、编码辅助、内容检索等场景中的价值,同时明确重大决策、关系维护和组织影响力建设不能简单交给 AI。',
  },
  {
    title: '对稳定性和长期运营负责',
    body: '从系统迁移、故障处理、监控、安全治理到平台成本,关注"上线之后是否能稳定运行",而不止是新技术体验。',
  },
];

// 当前关注问题
const focus = [
  '企业级 AI 平台的统一治理与规模化运营',
  'Agent 与工作流编排如何重构企业协作方式',
  'RAG 与知识库在企业复杂场景中的落地边界',
  'AI 工具链对研发提效的真实影响与使用边界',
];
---

<BaseLayout title="关于我">
  <!-- 长版自我介绍 -->
  <section class="page-intro border-b border-[var(--color-border)] bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
      <h1 class="mt-3 text-3xl sm:text-4xl">关于我</h1>
      <p class="mt-3 text-lg text-[var(--color-accent)]" style="letter-spacing: 0.04em">
        现任超大型多元化集团 · 高级研发总监 · 架构师
      </p>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-text)]">
        <p>
          我是{`袁飞扬`},集团总部高级架构师、数智化与 AI 条线 AI 产品与技术部门负责人,集团 AI 能力中枢、企业级智能体平台、统一 AI 入口等技术平台的技术出品人,负责集团 AI 战略规划、产品建设与工程化落地。
        </p>
        <p>
          15 年技术架构经验,长期深耕人工智能、云原生、微服务架构及企业级平台建设。现阶段重点探索能调用工具、编排任务并与人协作的企业智能体，关注它们在知识处理和业务流程中的实际应用。
        </p>
        <p>
          我关心的从来不是"AI 能做什么",而是"AI 在什么条件下,才真的能被一个组织用起来"。
        </p>
      </div>

      <!-- 职业阶段时间线 -->
      <div class="mt-12">
        <h2 class="text-xl">职业路径</h2>
        <ol class="mt-6 space-y-0">
          {journey.map((j, i) => (
            <li class="relative flex gap-5 pb-8 last:pb-0">
              {i < journey.length - 1 && (
                <span aria-hidden="true" class="absolute left-[7px] top-5 h-full w-px bg-[var(--color-border)]"></span>
              )}
              <span
                aria-hidden="true"
                class:list={[
                  'relative mt-1.5 h-[15px] w-[15px] shrink-0 rounded-full border-2',
                  i === journey.length - 1
                    ? 'border-[var(--color-accent)] bg-[var(--color-accent)]/20'
                    : 'border-[var(--color-border)] bg-white',
                ]}
              >
              </span>
              <div>
                <span class="inline-block rounded-lg bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent)]">
                  {j.phase}
                </span>
                <h3 class="mt-2 text-base">{j.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-muted)]">{j.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 能力地图 -->
  <Section chapter="ABILITY MAP" title="能力地图" subtitle="六个方向,从技术深度到组织协作。">
    <div class="space-y-6">{abilityMap.map(row => <div class="border-b border-[var(--color-border)] pb-5"><h3 class="text-lg">{row.direction}</h3><p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{row.detail}</p><p class="mt-2 leading-relaxed">{row.expression}</p></div>)}</div>
    <a href={url('/projects')} class="mt-5 inline-flex min-h-11 items-center">查看这些能力对应的项目案例 →</a>
  </Section>

  <!-- 工作方法与价值观 -->
  <Section chapter="METHODOLOGY & VALUES" title="工作方法与价值观">
    <div class="space-y-6">
      {values.map((v, i) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
          <h3 class="text-lg">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{v.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 当前关注问题 -->
  <Section chapter="CURRENT FOCUS" title="当前关注" subtitle="正在思考和推进的问题。">
    <ul class="space-y-3">
      {focus.map((f) => (
        <li class="flex items-start gap-3 text-[var(--color-text)]">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-lg bg-[var(--color-accent)]"></span>
          <span>{f}</span>
        </li>
      ))}
    </ul>
  </Section>
<div class="mx-auto w-full max-w-3xl px-6 pb-16"><ContactCTA /></div>
</BaseLayout>
