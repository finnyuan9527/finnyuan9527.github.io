---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, url } from '../config/site';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order-b.data.order).slice(0,3);
const notes = (await getCollection('notes')).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,2);
const abilities = [
  { title: 'AI 平台与治理', body: '统一模型接入、任务路由、权限与成本归因，让分散的 AI 调用可以持续运营。', href: '/projects/model-routing-gateway', label: '查看模型网关案例' },
  { title: '知识与业务智能化', body: '评估知识检索、智能体和任务编排，把模型能力放进有数据、有权限、有人负责的业务环节。', href: '/projects/enterprise-rag-knowledge', label: '查看知识库选型案例' },
  { title: '企业系统与工程交付', body: '梳理主数据、系统依赖与迁移边界，分阶段打通数据链路，保障业务连续性。', href: '/projects/enterprise-system-integration', label: '查看系统集成案例' },
];
---

<BaseLayout>
  <section class="home-hero">
    <div class="site-container hero-layout">
      <div class="hero-copy">
        <h1 class="signature">{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-message"><strong class="hero-statement">让 AI 真正进入业务流程。</strong><span class="hero-description">15 年技术架构经验，连接企业 AI 平台、知识与业务，从方案验证到工程交付。</span></p>
        <div class="hero-actions"><a href={url('/projects')} class="button-primary">查看项目案例 <span aria-hidden="true">↗</span></a><a href={url('/contact')} class="button-secondary">联系我</a></div>
      </div>
      <figure class="hero-visual">
        <img src={url('/images/abstract-ink-hero.webp')} alt="暖白纸面上石墨色弧形笔触、灰色墨迹与少量铜色构成的抽象画" width="1536" height="1024" fetchpriority="high" />
        <figcaption>留白与张力 <span>AI 生成抽象作品</span></figcaption>
      </figure>
    </div>
  </section>
  <section class="home-work site-container">
    <div class="section-heading"><div><h2>精选项目</h2><p>具体问题、承担的职责与公开结果。</p></div><a href={url('/projects')} class="text-link">全部项目案例 <span aria-hidden="true">↗</span></a></div>
    <div class="featured-projects">{projects.map(project => <ProjectCard project={project} headingLevel="h3" />)}</div>
  </section>
  <section class="home-capabilities site-container">
    <div class="section-heading"><div><h2>从技术架构，到业务现场</h2><p>关注模型之外的数据、流程、权限与长期运营。</p></div></div>
    <div class="capability-list">{abilities.map(item => <div class="capability-row"><h3>{item.title}</h3><p>{item.body}</p><a href={url(item.href)} class="text-link">{item.label}<span aria-hidden="true">↗</span></a></div>)}</div>
  </section>
  <section class="home-profile site-container">
    <div class="profile-title"><h2>关于我</h2><p>架构、产品与工程</p></div>
    <div class="profile-copy"><p>我在集团总部负责 AI 产品与技术工作，经历过互联网核心系统、企业平台与系统集成，如今重点探索企业智能体与 AI 平台的落地。</p><p>我关心的不只是系统如何建成，也包括它上线之后如何被组织用起来。</p><a href={url('/about')} class="text-link">了解职业经历与工作方法 <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="home-notes site-container">
    <div class="section-heading"><div><h2>思考与观点</h2><p>从实践中整理方法、验证清单与使用边界。</p></div><a href={url('/notes')} class="text-link">全部文章 <span aria-hidden="true">↗</span></a></div>
    <div class="reading-list">{notes.map(note => <NoteCard note={note} headingLevel="h3" />)}</div>
  </section>
  <div class="site-container home-contact"><ContactCTA /></div>
</BaseLayout>
