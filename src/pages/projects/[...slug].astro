---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels } from '../../config/categories';
import { url } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { title, tagline, category, role, problem, approach, outcome, retrospective } =
  project.data;

const fields = [
  { label: '我的角色', value: role },
  { label: '解决的问题', value: problem },
  { label: '解决方式', value: approach },
  { label: '结果', value: outcome },
  ...(retrospective ? [{ label: '复盘', value: retrospective }] : []),
];
---

<BaseLayout title={title} description={tagline}>
  <article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <a href={url('/projects')} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
      ← 返回项目
    </a>

    <div class="mt-6">
      <span class="rounded-full bg-[var(--color-accent)]/10 px-3 py-1 text-xs font-medium text-[var(--color-accent)]">
        {categoryLabels[category]}
      </span>
    </div>

    <h1 class="mt-4 text-3xl sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-[var(--color-muted)]">{tagline}</p>

    <!-- 按素材 7.5 模板渲染结构化字段 -->
    <dl class="mt-8 space-y-6">
      {fields.map((field) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-white p-5">
          <dt class="text-sm font-medium uppercase tracking-wider text-[var(--color-accent)]">
            {field.label}
          </dt>
          <dd class="mt-2 leading-relaxed text-[var(--color-text)]">{field.value}</dd>
        </div>
      ))}
    </dl>

    <!-- MDX 正文 -->
    <div class="prose mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose :global(h2) {
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(p) {
    color: var(--color-text);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
</style>
