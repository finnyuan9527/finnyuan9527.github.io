---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { categoryOptions } from '../../config/categories';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="项目案例" description="企业 AI 平台与治理、业务智能化、系统集成的项目案例，说明阶段、职责与公开结果。">
  <section class="page-intro border-b border-[var(--color-border)] bg-white"><div class="project-index mx-auto max-w-3xl px-6 py-12"><h1 class="mt-3 text-3xl sm:text-4xl">项目案例</h1>
    <p class="mt-3 leading-relaxed text-[var(--color-muted)]">按建设方向浏览，结合项目阶段、本人职责和结果判断经验是否适合你的问题。</p>
  </div></section>
  <div class="project-index mx-auto max-w-3xl px-6 py-8">
    <div class="flex flex-wrap gap-2" id="project-filters" role="group" aria-label="按建设方向筛选项目">
      {categoryOptions.map((cat,i) => <button type="button" data-category={cat.id} aria-pressed={i === 0 ? 'true' : 'false'} class="project-filter min-h-11 rounded-lg border border-[var(--color-border)] px-4 text-sm">{cat.label}</button>)}
    </div>
    <noscript><p class="my-5 text-sm text-[var(--color-muted)]">以下展示全部项目。</p><style>#project-filters, #project-count { display: none; }</style></noscript>
    <p id="project-count" class="my-5 text-sm text-[var(--color-muted)]" role="status" aria-live="polite" aria-atomic="true">全部：{projects.length} 个项目</p>
    <div class="grid gap-4 sm:grid-cols-2" id="project-grid">{projects.map((project, i) => <div data-category={project.data.category} data-lead={projects.length > 1 && projects.length % 2 === 1 && i === 0 ? true : undefined}><ProjectCard project={project} wide={projects.length > 1 && projects.length % 2 === 1 && i === 0} /></div>)}</div>
    <ContactCTA />
  </div>
</BaseLayout>
<style>.project-filter[aria-pressed="true"] { background: var(--color-primary); color: white; border-color: var(--color-primary); }</style>
<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#project-filters button'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('#project-grid > [data-category]'));
  function applyFilter(requested: string, push = false) {
    const category = buttons.some(btn => btn.dataset.category === requested) ? requested : 'all';
    let count = 0;
    buttons.forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.category === category)));
    items.forEach(item => { item.hidden = category !== 'all' && item.dataset.category !== category; if (!item.hidden) count++; });
    const firstVisible = items.find(item => !item.hidden);
    items.forEach(item => { const lead = count > 1 && count % 2 === 1 && item === firstVisible; item.toggleAttribute("data-lead", lead); item.querySelector(".project-card")?.classList.toggle("project-card-wide", lead); });
    const active = buttons.find(btn => btn.dataset.category === category);
    const status = document.querySelector('#project-count');
    if (status) status.textContent = `${active?.textContent?.trim()}：${count} 个项目`;
    const current = new URL(location.href);
    if (category === 'all') current.searchParams.delete('category'); else current.searchParams.set('category', category);
    if (push && current.href !== location.href) history.pushState(null, '', current);
    items.forEach(item => { const link = item.querySelector<HTMLAnchorElement>('[data-project-link]'); if (link) { const target = new URL(link.href); if (category === 'all') target.searchParams.delete('category'); else target.searchParams.set('category', category); link.href = target.href; } });
  }
  buttons.forEach(btn => btn.addEventListener('click', () => applyFilter(btn.dataset.category || 'all', true)));
  const restore = () => applyFilter(new URL(location.href).searchParams.get('category') || 'all');
  window.addEventListener('popstate', restore);
  window.addEventListener('pageshow', restore);
  restore();
</script>
