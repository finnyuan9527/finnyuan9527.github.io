---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { url } from '../../config/site';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const { title, description, date, updated, tags, relatedProjects } = note.data;
const projects = (await getCollection('projects')).filter(p => relatedProjects.includes(p.id));
const otherNotes = (await getCollection('notes')).filter(n => n.id !== note.id).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,2);

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} article={{ publishedTime: date, modifiedTime: updated, tags }}>
  <article class="article-page mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <a href={url('/notes')} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
      ← 返回思考与观点
    </a>

    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-[var(--color-muted)]">
      <time datetime={date.toISOString()}>发布于 {dateStr}</time>
      {updated && <time datetime={updated.toISOString()}>更新于 {updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
    </div>

    <h1 class="mt-2 text-3xl sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-[var(--color-muted)]">{description}</p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-lg bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs text-[var(--color-accent)]">
            {tag}
          </span>
        ))}
      </div>
    )}

    <ArticleContents headings={headings} />
    <div class="mt-10 border-t border-[var(--color-border)] pt-8">
      <Prose>
        <Content />
      </Prose>
    </div>
    {projects.length > 0 && <section class="mt-10 border-t border-[var(--color-border)] pt-8"><h2 class="text-xl">相关项目案例</h2><div class="mt-5 grid gap-4 sm:grid-cols-2">{projects.map((project, i) => <ProjectCard project={project} headingLevel="h3" wide={projects.length > 1 && projects.length % 2 === 1 && i === projects.length - 1} />)}</div></section>}
    <section class="mt-10"><h2 class="text-xl">继续阅读</h2><ul class="mt-3">{otherNotes.map(n => <li><a class="inline-flex min-h-11 items-center" href={url(`/notes/${n.id}`)}>{n.data.title} →</a></li>)}</ul></section>
    <ContactCTA />
  </article>
</BaseLayout>
