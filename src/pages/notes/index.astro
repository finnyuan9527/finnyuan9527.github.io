---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="思考" description="关于 AI 边界、流程重构与企业架构的实践笔记。">
  <section class="border-b border-[var(--color-border)] bg-white">
    <div class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <p class="chapter-label">ESSAYS</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">思考与观点</h1>
      <p class="mt-3 text-[var(--color-muted)]">
        关于 AI 边界、流程重构、企业架构与技术趋势的实践笔记。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-6 py-8">
    <div class="space-y-4">
      {notes.map((note) => (
        <NoteCard note={note} />
      ))}
    </div>
  </div>
</BaseLayout>
