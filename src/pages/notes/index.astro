---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => Number(b.id === 'writing-the-road-ahead') - Number(a.id === 'writing-the-road-ahead') || b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="思考与观点" description="关于 AI 边界、流程重构与企业架构的实践笔记。">
  <section class="page-intro border-b border-[var(--color-border)] bg-white">
    <div class="notes-index mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <h1 class="mt-3 text-3xl sm:text-4xl">思考与观点</h1>
      <p class="mt-3 text-[var(--color-muted)]">
        把经历写下来，也把问题想得更清楚一些。这里有工作中的判断，有回望时的感受，也有关于下一段路的思考。
      </p>
    </div>
  </section>

  <div class="notes-index mx-auto max-w-3xl px-6 py-8">
    <div class="notes-archive">
      {notes.map((note) => (
        <NoteCard note={note} />
      ))}
    </div>
  </div>
</BaseLayout>
